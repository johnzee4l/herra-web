# .env.example
# Copy this to .env.local and fill in your values

# Supabase Configuration (Required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Access Code Security (Required)
# Generate with: openssl rand -hex 32
HMAC_PEPPER=your-random-32-byte-hex-string-here

# Cron Job Security (Required)
# Generate with: openssl rand -hex 32
CRON_SECRET=your-random-cron-secret-here

# Optional: Override provider URLs
# OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
# PHOTON_BASE_URL=https://photon.komoot.io

# Optional: Site URL for email links
# NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app
